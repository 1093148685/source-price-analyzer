@app.get("/", response_class=HTMLResponse)
def index(request: Request):
    data = build_snapshot(False)
    selected = request.query_params.get("group") or (data["groups"][0]["slug"] if data["groups"] else "")
    q = (request.query_params.get("q") or "").strip()
    hero = sorted(data["groups"], key=lambda g: (g["min_price"] or 999999))[:3]
    return Template(HTML).render(groups=data["groups"], hero_groups=hero, stats=data["stats"], selected=selected, q=q, generated=time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(data["generated_at"])), ttl=CACHE_TTL)


@app.get("/refresh")
def refresh():
    build_snapshot(True)
    return RedirectResponse(url="/", status_code=302)


@app.get("/api/data")
def api_data():
    return JSONResponse(build_snapshot(False))


@app.get("/api/group/{slug}")
def api_group(slug: str):
    data = build_snapshot(False)
    for g in data["groups"]:
        if g["slug"] == slug:
            return JSONResponse(g)
    return JSONResponse({"error": "not found"}, status_code=404)


