def _session() -> requests.Session:
    s = requests.Session()
    s.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/126 Safari/537.36",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
    })
    if ESA_COOKIE:
        s.cookies.set("acw_sc__v2", ESA_COOKIE, domain="pay.ldxp.cn")
    return s


def _load_token() -> str | None:
    try:
        data = json.load(open(TOKEN_FILE, encoding="utf-8"))
        if data.get("expires", 0) > time.time() and data.get("token"):
            return data["token"]
    except Exception:
        pass
    return None


def _save_token(token: str):
    with open(TOKEN_FILE, "w", encoding="utf-8") as f:
        json.dump({"token": token, "expires": time.time() + 3600 * 6}, f)


def _login() -> str:
    token = _load_token()
    if token:
        return token
    if not PASSWORD:
        raise RuntimeError("缺少 LDXP_PASSWORD 环境变量，无法刷新链动小铺 token")
    s = _session()
    r = s.post(
        BASE + "/merchantApi/user/login",
        json={"username": USERNAME, "password": PASSWORD},
        headers={"Accept": "application/json, text/plain, */*", "Content-Type": "application/json", "Referer": BASE + "/merchant/login"},
        timeout=30,
    )
    data = r.json()
    if data.get("code") != 1:
        raise RuntimeError(f"链动登录失败: {data.get('msg')}")
    token = data["data"]["merchant_token"]
    _save_token(token)
    return token


def _api_post(path: str, payload: dict[str, Any]) -> dict[str, Any]:
    token = _login()
    s = _session()
    s.cookies.set("merchant-token", token, domain="pay.ldxp.cn")
    h = {
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/json",
        "Referer": BASE + "/merchant/my_parent/source_square",
        "merchant-token": token,
    }
    r = s.post(BASE + path, json=payload, headers=h, timeout=40)
    data = r.json()
    if data.get("code") == 401 or data.get("msg") in ("登录已过期", "请先登录"):
        try:
            os.remove(TOKEN_FILE)
        except FileNotFoundError:
            pass
        return _api_post(path, payload)
    return data


def _price(item: dict[str, Any]) -> float:
    for k in ["agent_price_limit", "agent_price3", "agent_price2", "agent_price1", "cost_price", "price"]:
        v = item.get(k)
        try:
            if v is not None and float(v) > 0:
                return round(float(v), 2)
        except Exception:
            pass
    return 0.0


def _strip(text: str) -> str:
    text = re.sub(r"<script[\s\S]*?</script>|<style[\s\S]*?</style>", " ", text or "")
    text = re.sub(r"<[^>]+>", " ", text)
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def _dedupe(items: list[dict[str, Any]]) -> list[dict[str, Any]]:
    seen, out = set(), []
    for it in items:
        gid = it.get("id") or it.get("goods_key") or it.get("link")
        if gid in seen:
            continue
        seen.add(gid)
        out.append(it)
    return out


def fetch_group(group: dict[str, Any], page_size: int = 40) -> dict[str, Any]:
    raw_items = []
    for kw in group["keywords"]:
        data = _api_post("/merchantApi/MyParent/searchGoodsList", {
            "current": 1,
            "pageSize": page_size,
            "goods_type": "card",
            "keywords": kw,
            "name": "",
        })
        raw_items.extend(((data.get("data") or {}).get("list") or []))
    items = []
    for it in _dedupe(raw_items):
        user = it.get("user") or {}
        category = it.get("category") or {}
        p = _price(it)
        if p <= 0:
            continue
        items.append({
            "id": it.get("id"),
            "name": it.get("name") or "未命名商品",
            "price": p,
            "stock": int(it.get("stock_count") or 0),
            "status": it.get("status"),
            "verify": it.get("verify"),
            "link": it.get("link"),
            "category": category.get("name") or "未分类",
            "shop": user.get("nickname") or "未知商家",
            "shop_link": user.get("link"),
            "avatar": user.get("avatar"),
            "contact": user.get("contact_qq") or user.get("contact_wechat") or user.get("contact_mobile") or "",
            "summary": _strip(it.get("description") or "")[:180],
        })
    items.sort(key=lambda x: (x["price"], -x["stock"]))
    prices = [x["price"] for x in items]
    shops = len({x["shop"] for x in items})
    cats = len({x["category"] for x in items})
    return {
        **group,
        "count": len(items),
        "shops": shops,
        "categories": cats,
        "stock": sum(x["stock"] for x in items),
        "min_price": min(prices) if prices else 0,
        "max_price": max(prices) if prices else 0,
        "avg_price": round(statistics.mean(prices), 2) if prices else 0,
        "median_price": round(statistics.median(prices), 2) if prices else 0,
        "best": items[:3],
        "items": items,
    }


def build_snapshot(force: bool = False) -> dict[str, Any]:
    if not force:
        try:
            cache = json.load(open(CACHE_FILE, encoding="utf-8"))
            if cache.get("expires", 0) > time.time():
                return cache
        except Exception:
            pass
    groups = [fetch_group(g) for g in PRODUCT_GROUPS]
    all_items = [it for g in groups for it in g["items"]]
    snapshot = {
        "generated_at": int(time.time()),
        "expires": time.time() + CACHE_TTL,
        "groups": groups,
        "stats": {
            "product_groups": len(groups),
            "products": len(all_items),
            "shops": len({x["shop"] for x in all_items}),
            "lowest": min([x["price"] for x in all_items], default=0),
        },
    }
    with open(CACHE_FILE, "w", encoding="utf-8") as f:
        json.dump(snapshot, f, ensure_ascii=False, indent=2)
    return snapshot


